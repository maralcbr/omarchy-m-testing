<% split = row.boards.size > 1 ? row.boards.select { |board| board.result(area).tallies.any? } : [] %>
<td class="lineup-status" data-area="<%= area %>" data-state="<%= status.state %>" data-source="<%= status.source %>"<% if status.cell %> title="<%= status.cell.summary %>"<% end %>>
  <%= state_badge(status.state, label: status.words) %><%= " (unconfirmed)" if status.unconfirmed? %>
  <% if status.note.present? %><span class="dim lineup-note"><%= status.note %></span><% end %>
  <% split.each do |board| %>
    <% cell = board.result(area) %>
    <div class="lineup-tested" data-board="<%= board.board %>" data-state="<%= cell.display_state %>" title="<%= cell.summary %>">
      <%= board.board.upcase %>: <%= state_badge(cell.display_state, label: MacLineup.words(cell.display_state)) %><%= " (unconfirmed)" if cell.unconfirmed? %>
    </div>
  <% end %>
</td>
