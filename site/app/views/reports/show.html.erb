<% content_for :title, "#{@report.short_model_name} report" %>
<article class="report terminal">
  <div class="terminal-bar">
    <span class="terminal-title">omarchy-m-test</span>
    <span class="dim">report <%= @report.public_id %></span>
  </div>
  <div class="terminal-body">
    <p class="prompt-line"><span class="prompt">$</span> omarchy-m-test</p>
    <h1><%= @report.machine["model"] %></h1>
    <p class="report-badges">
      <%= run_badge(@report, long: true) %>
      <% if @report.hidden? %><span class="badge badge-regression">hidden by the admin</span><% end %>
    </p>
    <dl class="machine">
      <dt>chip</dt><dd><%= @report.machine["chip"] %> (<%= @report.machine["soc"] %>, board <%= @report.machine["board"] %>)</dd>
      <dt>kernel</dt><dd><%= @report.machine["kernel"] %></dd>
      <dt>stack</dt><dd><%= @report.stack_words %> <%= @report.omarchy_version %><% if @report.candidate_set %>, candidate set <a href="<%= candidate_path(@report.candidate_set) %>"><%= @report.candidate_set %></a><% end %></dd>
      <dt>build</dt><dd id="build"><%= build_summary(@report, long: true) %></dd>
      <% if (image = @report.build&.image).present? %>
        <dt>image</dt><dd id="image"><%= @report.build.image_words %></dd>
      <% end %>
      <dt>system</dt><dd><%= @report.system["distro"] %>, <%= @report.system["boot_loader"] %>, encryption <%= @report.system["encryption"] %></dd>
      <dt>tool</dt><dd><%= @report.body.dig("tool", "name") %> <%= @report.body.dig("tool", "version") %></dd>
      <dt>catalogue</dt><dd>feature catalogue v<%= @report.body["catalogue_version"] %></dd>
      <dt>uploaded</dt><dd><%= uploaded_at(@report) %></dd>
      <dt>results</dt><dd><%= result_counts(@report, separator: " · ") %></dd>
      <% if @report.unattended? %>
        <dt>run</dt><dd id="unattended">unattended: nobody was at the Mac, so only the automatic checks ran</dd>
      <% end %>
    </dl>
    <details class="packages" id="packages" open>
      <summary>packages (<%= @report.system["packages"].size %>)</summary>
      <table class="package-table">
        <% @report.system["packages"].each do |package| %>
          <tr><td><%= package["name"] %></td><td><%= package["version"] %></td></tr>
        <% end %>
      </table>
    </details>

    <% @report.checks.group_by { |check| check_section(check["id"]) }.each do |section, checks| %>
      <h2 class="section-title"><%= section %></h2>
      <ul class="checks">
        <% checks.each do |check| %>
          <li class="check check-<%= status_class(check) %>" id="check-<%= check["id"] %>">
            <span class="status status-<%= status_class(check) %>"><%= status_label(check) %></span>
            <span class="check-id"><%= check["id"] %></span>
            <% if (classification = check["classification"]) %>
              <%= check_outcome_badge(check) %>
              <% if classification["outcome"] == "fails" && @report.regression?(classification["feature"]) %>
                <% pass = @report.regressed_from(classification["feature"]) %>
                <a class="badge badge-regression regression" href="<%= report_path(pass) %>" title="A tester's earlier run on this model and stack found it working (<%= pass.stack_words %> <%= pass.omarchy_version %>, <%= uploaded_at(pass) %>)">regression</a>
              <% end %>
              <span class="feature"><%= Catalogue.feature(classification["feature"])&.fetch("name") || classification["feature"] %>, <%= classification["layer"] %> layer</span>
              <%= issue_link(IssueDraft.for_check(@report, check, url_for: report_link_for)) if admin? && !@report.hidden? && IssueDraft.check?(check) %>
            <% end %>
            <% if (score = check["score"]).is_a?(Hash) %>
              <span class="score">score <strong><%= score_words(score["value"]) %></strong> <%= BenchmarkScores::UNITS.fetch(score["unit"], score["unit"]) %> (<%= score["tool"] %>, suite <%= score["suite"] %>) · <a href="<%= benchmarks_path(anchor: "benchmark-#{check["id"].delete_prefix("benchmark.")}-suite-#{score["suite"]}") %>">compare</a></span>
            <% end %>
            <% if check["evidence"].any? %>
              <pre class="evidence"><%= check["evidence"].join("\n") %></pre>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <%= render "inventory", inventory: @report.body["inventory"] if @report.body["inventory"].is_a?(Hash) %>

  </div>
</article>
<p class="credit dim">Asahi hardware states: <a href="https://asahilinux.org/docs/platform/feature-support/overview/">Asahi Linux feature support</a>, CC BY 3.0. <a href="<%= model_path(@report.board) %>">More on this Mac</a>.</p>
